# The Node service needs a publicly reachable HTTPS/WSS address for online play.
HOST=0.0.0.0
PORT=8080
ALLOWED_ORIGINS=https://axel-nl94.github.io
# Build-time public address for the GitHub Pages frontend:
RETROROOM_SERVER_URL=wss://your-lobby-host.example/ws
# Optional self-hosted coturn REST credentials, minted for each connection:
# TURN_URLS=turn:turn.example:3478,turns:turn.example:5349
# TURN_SECRET=configure-the-same-secret-in-coturn
# Alternative provider configuration (delivered to clients, never a provider API key):
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
